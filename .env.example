# Notion API Configuration
NOTION_API_KEY=your_notion_api_key_here
NOTION_PARROTS_DATABASE_ID=your_database_id_here
NOTION_VISITS_DATABASE_ID=your_visits_database_id_here
NOTION_VISITORS_DATABASE_ID=your_visitors_database_id_here
NOTION_BLOG_DATABASE_ID=your_blog_database_id_here
NOTION_REVIEWS_DATABASE_ID=your_google_reviews_database_id_here
NOTION_GIFT_CARDS_DATABASE_ID=dec153a985814b64b1296af38d0168df

# Gift cardi väljastamise endpointi turvavõti (kasuta Vercelis, et ainult admin saaks kaarte e-mailida)
GIFT_CARD_ISSUE_SECRET=your_secret_here

# SMTP configuration (Papagoi Keskus)
SMTP_HOST=mail.papagoi.ee
SMTP_PORT=587
SMTP_USER=keskus@papagoi.ee
SMTP_PASSWORD=your_smtp_password_here

# Notion Automations webhook (valikuline)
NOTION_WEBHOOK_SECRET=your_webhook_secret_here

# Google Places API (for reviews and ratings)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Google review link (for review invitation emails)
REVIEW_GOOGLE_URL=https://g.page/r/CXfsGh_UtN6-EBM/review
# Kui 1, saadetakse iga arvustuskutse kiri ka CC-na keskuse mailile (vaikimisi ei saadeta)
# REVIEW_CC_CENTER=1

# Google My Business API (for full reviews sync)
GOOGLE_MY_BUSINESS_CLIENT_ID=your_oauth_client_id_here
GOOGLE_MY_BUSINESS_CLIENT_SECRET=your_oauth_client_secret_here
GOOGLE_MY_BUSINESS_REFRESH_TOKEN=your_refresh_token_here
GOOGLE_MY_BUSINESS_ACCOUNT_ID=your_account_id_here
GOOGLE_MY_BUSINESS_LOCATION_ID=your_location_id_here

# Automaatvastus Google arvustustele: ainult 4–5★ alates sellest kuupäevast (Europe/Tallinn).
# Cron ei täida vanu kirjeid tagantjärele. Käivitamine = Kinnitatud + see kuupäev.
# GMB_AUTO_REPLY_SINCE=2026-08-27

# Sendberry SMS API (külastuse meeldetuletused)
SENDBERRY_API_KEY=your_sendberry_api_key_here
SENDBERRY_NAME=your_sendberry_username_here
SENDBERRY_PASSWORD=your_sendberry_password_here
SENDBERRY_FROM=Papagoi
# soovi korral override: default https://api.sendberry.com/SMS/SEND
SENDBERRY_SMS_ENDPOINT=https://api.sendberry.com/SMS/SEND

# SMS külastuse meeldetuletuse Google Maps link (soovitavalt lühike URL)
VISIT_SMS_MAP_URL=https://bit.ly/your-short-maps-link

# Kui 1, siis skript ainult logib ega saada SMS-e
VISIT_SMS_DRY_RUN=1

# Vercel Cron auth (vähemalt 16 juhuslikku märki). Vercel saadab selle Bearer päisena.
# Kohustuslik productionis — ilma selleta SMS/review cron otspunktid vastavad 401.
CRON_SECRET=generate_a_long_random_secret_here

# Base URL (production: https://papagoi.ee — ilma www-ta)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# NEXT_PUBLIC_SITE_URL=https://papagoi.ee

# Meta Pixel + Conversions API (sama dataset ID mõlemale)
META_PIXEL_ID=847652724033387
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=

# Vercel kinkekaardi render (valikuline; vaikimisi GitHub pack v149 x64)
# CHROMIUM_PACK_URL=https://github.com/Sparticuz/chromium/releases/download/v149.0.0/chromium-v149.0.0-pack.x64.tar
